{
  "name": "sael-pro",
  "version": "1.0.0",
  "description": "Saël Simard — sael.pro portfolio storefront (Payload CMS + Next.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "media:import:wordpress": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/import-wordpress-archive.ts",
    "media:validate": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/validate-public-media.ts",
    "og:warm": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/warm-og-images.ts",
    "content:validate": "cross-env NODE_OPTIONS=--no-deprecation tsx tools/validate-public-content.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:headed": "playwright test --headed",
    "test:ux:baseline": "cross-env SAEL_CAPTURE_BASELINES=1 playwright test tests/e2e/visual-baseline.spec.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-form-builder": "3.86.0",
    "@payloadcms/plugin-redirects": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@vercel/blob": "^1.1.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "next": "15.4.11",
    "next-sitemap": "^4.2.3",
    "payload": "3.86.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.4.38",
    "tsx": "4.20.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "24.x"
  }
}
