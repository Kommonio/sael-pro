# Local development: SQLite file
# Vercel / production: Postgres (Neon)
#   DATABASE_URL=file:./saelpro.db
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=file:./saelpro.db

# Used to encrypt JWT tokens (required in production)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL — no trailing slash
# Local: http://localhost:3000
# Temp: https://saelpro.vercel.app
# Production: https://sael.pro
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Preview / cron
PREVIEW_SECRET=change-me-preview
CRON_SECRET=change-me-cron

# Vercel Blob — Payload Media
# Create a Blob store on the Vercel project (CLI or dashboard).
# BLOB_READ_WRITE_TOKEN=

# Optional first admin (used by `npm run seed` if no users exist)
SEED_ADMIN_EMAIL=sael@sael.pro
SEED_ADMIN_PASSWORD=change-me-admin
